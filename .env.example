# Database
DATABASE_URL=postgresql://psuser:pspassword@localhost:5432/premiumshare
DATABASE_TEST_URL=postgresql://psuser:pspassword@localhost:5433/premiumshare_test

# Auth
NEXTAUTH_SECRET=change-this-to-a-random-32-character-string
NEXTAUTH_URL=http://localhost:3000

# Email (MailDev for local, real SMTP for production)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@premiumshare.demo

# Business Mode: DEMO or MANUAL
BUSINESS_MODE=DEMO

# Family automation (DEMO only by default; AUTHORIZED_BROWSER locked / real UI unverified)
FAMILY_AUTOMATION_MODE=DEMO
AUTHORIZED_BROWSER_ENABLED=false
MOCK_FAMILY_ADMIN_URL=http://127.0.0.1:3100
MOCK_FAMILY_ADMIN_PORT=3100
FAMILY_RUNNER_ID=family-runner-1
FAMILY_RUNNER_POLL_MS=3000

# File uploads
UPLOAD_MAX_SIZE_MB=10
UPLOAD_DIR=./uploads

# Worker
WORKER_ID=worker-1

# Node
NODE_ENV=development
