{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": ".",
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "@premium-share/domain": ["../../packages/domain/src/index.ts"],
      "@premium-share/domain/*": ["../../packages/domain/src/*"]
    }
  },
  "include": ["server.ts", "src/server/**/*.ts"],
  "exclude": ["node_modules"]
}
